# Copie este arquivo para ".env" (sem o .example) e troque os valores.
# O arquivo .env NÃO vai para o Git, porque guarda segredos.

# Porta em que o servidor vai rodar
PORTA=3000

# Frase secreta usada para assinar os tokens de login.
# Troque por qualquer texto grande e difícil de adivinhar.
JWT_SEGREDO=troque-esta-frase-por-uma-bem-grande-e-secreta

# Login mestre do D.A. (criado automaticamente na primeira vez que o servidor sobe)
ADMIN_USUARIO=admin
ADMIN_SENHA=TeraAdmin2026
